package Tp2;

public class Banque {
    private String nom;
    private Comptebancaire[] comptes;
    private int nbActuels;

       public Banque(String nom, int capaciteMax) {
        this.nom = nom;
        this.comptes = new Comptebancaire[capaciteMax];
        this.nbActuels = 0;
    }

    public void ajouterCompte(Comptebancaire c) {
        if (nbActuels < comptes.length) {
            comptes[nbActuels] = c;
            nbActuels++;
            System.out.println("Compte ajouté avec succès !");
        } else {
            System.out.println("La banque est pleine !");
        }
    }

    public void afficherTous() {
        if (nbActuels == 0) {
            System.out.println("Aucun compte dans la banque.");
            return;
        }

        for (int i = 0; i < nbActuels; i++) {
            comptes[i].afficher();
        }
    }
}
